# Copy this file to .env for local development. Leave secrets blank here.
# Never commit .env or paste secret values into chat, issues, screenshots, or logs.

# Local storage and GitHub inspection
DATABASE_PATH=data/career_coach.sqlite3
# WAL is fast locally. Azure's single-replica Azure Files deployment uses DELETE mode.
SQLITE_JOURNAL_MODE=WAL
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15
GITHUB_MAX_FILES=20
GITHUB_MAX_FILE_BYTES=200000
GITHUB_MAX_TOTAL_BYTES=1500000
POLL_INTERVAL_SECONDS=10
MONITORING_ENABLED=true

# Primary LLM: optional interpretation only; deterministic evidence always remains authoritative.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_LLM_EXPLANATIONS=false

# Optional Grok/xAI fallback: used only after eligible transient OpenAI failures.
XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1
XAI_MODEL=
ENABLE_XAI_FALLBACK=false

# Optional JSearch/RapidAPI job discovery. Selected jobs still retain their direct posting URL.
JSEARCH_API_KEY=
JSEARCH_API_URL=https://jsearch.p.rapidapi.com
JSEARCH_TIMEOUT_SECONDS=15

# Optional Telegram notifications. Enable only after webhook pairing is implemented and configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_PAIRING_TTL_SECONDS=600
TELEGRAM_TIMEOUT_SECONDS=12
PUBLIC_BASE_URL=

# Azure runtime observability and secret references. Configure values as Azure app settings/Key Vault references in production.
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
